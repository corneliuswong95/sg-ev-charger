# LTA DataMall AccountKey — required.
# Register a free key at https://datamall.lta.gov.sg
LTA_ACCOUNT_KEY=

# URA Data Service AccessKey — optional. Enables URA public car park rates.
# Register free at https://eservice.ura.gov.sg/maps/api/reg.html
URA_ACCESS_KEY=

# Show LTA OneMotoring parking rates inline (malls, offices, hotels).
# OneMotoring's terms of use require LTA's written permission to reproduce its
# contents, so leave this off (link to OneMotoring only) until LTA has agreed.
ONEMOTORING_INLINE=
