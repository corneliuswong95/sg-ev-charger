# LTA DataMall AccountKey — required.
# Register a free key at https://datamall.lta.gov.sg
LTA_ACCOUNT_KEY=

# URA Data Service AccessKey — optional. Enables URA public car park rates.
# Register free at https://eservice.ura.gov.sg/maps/api/reg.html
URA_ACCESS_KEY=

# LTA OneMotoring parking rates (malls, offices, hotels) are shown inline —
# LTA gave written permission in Oct 2026 for 12 months, renewable. Set to 0 to
# go back to linking to OneMotoring only (e.g. if permission lapses).
ONEMOTORING_INLINE=

# History collector (optional; see docs/history-stats.md). All server-only.
# Supabase project URL and a *secret* key (sb_secret_…, Settings → API Keys).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Shared password GitHub Actions sends to /api/cron/snapshot (same value as
# the CRON_SECRET repository secret on GitHub).
CRON_SECRET=
